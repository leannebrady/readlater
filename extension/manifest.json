{
  "manifest_version": 3,
  "name": "ReadLater",
  "version": "1.0.0",
  "description": "Save the current page to your ReadLater reading list in one click.",
  "permissions": ["activeTab", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:3000/*", "https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "Save to ReadLater" },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current page to ReadLater"
    }
  }
}
